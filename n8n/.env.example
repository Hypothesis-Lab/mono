# Local n8n development settings.
# Copy this file to .env before starting the stack.

N8N_VERSION=2.32.0
N8N_PORT=5678
N8N_BIND_ADDRESS=127.0.0.1
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
