<mxfile host="embed.diagrams.net" agent="OpenCode" pages="27">
  <diagram id="overview" name="00 Обзор пайплайна">
    <mxGraphModel dx="1553" dy="1864" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" value="&lt;b&gt;Карта product-пайплайна Tempo — полная логика&lt;/b&gt;" vertex="1">
          <mxGeometry height="45" width="1500" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Как читать схему&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;Синие узлы — вызовы модели; жёлтые — детерминированная логика; зелёные — сохранённые результаты. Нажмите узел или выберите страницу prompt в списке страниц слева: там полный текст разбит на читаемые части.&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="1500" x="30" y="80" as="geometry" />
        </mxCell>
        <mxCell id="sources" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;ВХОДНЫЕ ДАННЫЕ&#xa;файлы источников&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;n8n/product/*.md&lt;br&gt;load_sources() сортирует файлы и читает полное содержимое. README.md исключается.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="220" x="40" y="220" as="geometry" />
        </mxCell>
        <mxCell id="fanout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;START → fan_out_sources&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;LangGraph Send создаёт отдельный extract_source для каждого источника.&lt;br&gt;Задачи выполняются параллельно, drafts объединяются через operator.add.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="250" x="310" y="220" as="geometry" />
        </mxCell>
        <mxCell id="extract" link="data:page/id,extraction-prompt-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;МОДЕЛЬ: extract_source&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;Один structured-вызов Passport на источник.&lt;br&gt;Prompt: tempo-product-extraction.md&lt;br&gt;Схема ответа: Passport&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="250" x="610" y="220" as="geometry" />
        </mxCell>
        <mxCell id="drafts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;ЧЕРНОВИКИ&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;Draft(source, result) для каждого источника.&lt;br&gt;Каждый draft сохраняет локальный паспорт и evidence.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="220" x="910" y="220" as="geometry" />
        </mxCell>
        <mxCell id="consolidate" link="data:page/id,consolidation-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;МОДЕЛЬ: consolidate&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;Объединяет только подтверждённые факты; сохраняет evidence, conflicts, gaps и условия.&lt;br&gt;Перенумеровывает records r1… и сортирует по category.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="270" x="1180" y="220" as="geometry" />
        </mxCell>
        <mxCell id="validate" link="data:page/id,validation-repair-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;ДЕТЕРМИНИРОВАННО: validate&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;Проверяет последовательные ID записей, statements, evidence, source/quote и ссылки конфликтов.&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="270" x="1180" y="390" as="geometry" />
        </mxCell>
        <mxCell id="decision" parent="1" style="rounded=1;whiteSpace=wrap;html=1;rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;ВАЛИДНО?&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;valid и repair ещё не выполнялся → finalize&lt;br&gt;invalid → repair&lt;br&gt;repair уже был → finalize&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="220" x="900" y="390" as="geometry" />
        </mxCell>
        <mxCell id="repair" link="data:page/id,validation-repair-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;МОДЕЛЬ: repair (условно)&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;Получает только passport и validation.errors.&lt;br&gt;Может исправить структуру, но не добавляет факты и не удаляет evidence.&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="250" x="610" y="390" as="geometry" />
        </mxCell>
        <mxCell id="finalize" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;ДЕТЕРМИНИРОВАННО: finalize&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;Повторно запускает validate_passport().&lt;br&gt;Формирует финальные Passport + Validation.&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="250" x="310" y="390" as="geometry" />
        </mxCell>
        <mxCell id="evaluate" link="data:page/id,evaluation-prompt-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;МОДЕЛЬ: evaluate&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;Аудит источников по полному evaluation prompt.&lt;br&gt;Получает passport, validation и исходные материалы.&lt;br&gt;Результат: Evaluation.&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="220" x="40" y="390" as="geometry" />
        </mxCell>
        <mxCell id="result" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;СОХРАНЁННЫЙ РЕЗУЛЬТАТ&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;runner инкрементально пишет JSON: status, duration, calls, token counts, checkpoint, passport, validation и evaluation.&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="300" x="40" y="570" as="geometry" />
        </mxCell>
        <mxCell id="benchmark" link="data:page/id,benchmark-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;BENCHMARK × 3 ЗАПУСКА&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;Run 1: обычный порядок источников&lt;br&gt;Run 2: обратный порядок&lt;br&gt;Run 3: детерминированный shuffle Random(42)&lt;br&gt;После 3 паспортов: C9 stability evaluator.&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="340" x="430" y="570" as="geometry" />
        </mxCell>
        <mxCell id="stability" link="data:page/id,benchmark-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;МОДЕЛЬ: C9 stability evaluator&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;Сравнивает паспорта, validation, условия, числа, evidence, conflicts, gaps и границы продукта.&lt;br&gt;Результат: StabilityEvaluation.&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="310" x="860" y="570" as="geometry" />
        </mxCell>
        <mxCell id="handoff" link="data:page/id,orchestration-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;ДЕТЕРМИНИРОВАННАЯ ПЕРЕДАЧА&lt;/b&gt;&lt;/div&gt;&lt;div style=&#39;font-size:12px;margin-top:8px&#39;&gt;load_product_passport() выбирает минимальный run_number среди завершённых.&lt;br&gt;compact_product_passport() передаёт records и product_jtbd в audience pipeline.&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="250" x="1260" y="570" as="geometry" />
        </mxCell>
