        </mxCell>
        <mxCell id="edge7" edge="1" parent="1" source="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="repair" value="invalid">
          <mxGeometry relative="1" as="geometry" />
