        <mxCell id="title" value="&lt;b&gt;04 Полный prompt аудита результата — часть 4/4&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
