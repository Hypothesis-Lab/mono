  <diagram id="benchmark-1" name="05 Benchmark × 3 и C9 prompt — часть 1/4">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;05 Benchmark × 3 и C9 prompt — часть 1/4&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная оркестрация benchmark, политика порядка источников и template prompt stability evaluator." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part1" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 1/4&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;# eval/benchmark.py :: run_benchmark&#xa;async def run_benchmark(args: argparse.Namespace) -&amp;gt; None:&#xa;    if not args.api_key:&#xa;        raise SystemExit(&amp;quot;OPENROUTER_API_KEY or --api-key is required&amp;quot;)&#xa;    payload = load_payload(args.output)&#xa;    models = load_models(args.models, args.models_file)&#xa;    models = [model for model in models if model not in set(args.exclude_model)]&#xa;    if not models:&#xa;        raise SystemExit(&amp;quot;no models remain after exclusions&amp;quot;)&#xa;    if args.force:&#xa;        reset_models(payload, models, args.checkpoints)&#xa;    elif args.retry_failed:&#xa;        reset_failed(payload, models)&#xa;    payload.setdefault(&amp;quot;results&amp;quot;, [])&#xa;    payload.setdefault(&amp;quot;evaluations&amp;quot;, [])&#xa;    payload[&amp;quot;pipeline&amp;quot;] = &amp;quot;product&amp;quot;&#xa;    payload[&amp;quot;benchmark&amp;quot;] = {&#xa;        &amp;quot;max_runs&amp;quot;: args.runs,&#xa;        &amp;quot;target_product&amp;quot;: args.target_product,&#xa;        &amp;quot;as_of_date&amp;quot;: args.as_of_date,&#xa;        &amp;quot;pipeline&amp;quot;: &amp;quot;product&amp;quot;,&#xa;    }&#xa;    writer = ResultWriter(args.output, {}, payload)&#xa;    sources = load_sources(args.input_dir)&#xa;    await asyncio.gather(*(run_model_slots(model, sources, args=args, writer=writer) for model in models))&#xa;&#xa;# eval/benchmark.py :: run_model_slots&#xa;async def run_model_slots(model: str, sources: list[Source], *, args: argparse.Namespace, writer: ResultWriter) -&amp;gt; None:&#xa;    tasks = []&#xa;    for run_number in range(1, args.runs + 1):&#xa;        if has_run(writer.payload, model, run_number):&#xa;            continue&#xa;        checkpoint_path = args.checkpoints / slugify(model) / f&amp;quot;run-{run_number}.sqlite&amp;quot;&#xa;        checkpoint_path.parent.mkdir(parents=True, exist_ok=True)&#xa;        ordered_sources = sources_for_run(sources, run_number)&#xa;        tasks.append(&#xa;            run_one_model(&#xa;                model,&#xa;                ordered_sources,&#xa;                target_product=args.target_product,&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="benchmark-2" name="05 Benchmark × 3 и C9 prompt — часть 2/4">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;05 Benchmark × 3 и C9 prompt — часть 2/4&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная оркестрация benchmark, политика порядка источников и template prompt stability evaluator." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part2" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 2/4&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;                as_of_date=args.as_of_date,&#xa;                api_key=args.api_key,&#xa;                base_url=args.base_url,&#xa;                checkpoint_dir=args.checkpoints,&#xa;                timeout_seconds=args.timeout,&#xa;                step_retries=args.step_retries,&#xa;                app_url=args.app_url,&#xa;                app_name=args.app_name,&#xa;                run_id=f&amp;quot;{args.run_id}:{slugify(model)}:run-{run_number}&amp;quot;,&#xa;                writer=writer,&#xa;                run_number=run_number,&#xa;                checkpoint_path=checkpoint_path,&#xa;                resume=checkpoint_path.exists(),&#xa;                source_order=[source.source for source in ordered_sources],&#xa;                pipeline=&amp;quot;product&amp;quot;,&#xa;                rate_limit_wait_budget_seconds=args.rate_limit_budget,&#xa;            )&#xa;        )&#xa;    if tasks:&#xa;        await asyncio.gather(*tasks)&#xa;    runs = completed_runs(writer.payload, model, args.runs)&#xa;    if len(runs) == args.runs and not has_evaluation(writer.payload, model):&#xa;        await evaluate_stability(model, runs, sources, args=args, writer=writer)&#xa;&#xa;# eval/benchmark.py :: evaluate_stability&#xa;async def evaluate_stability(&#xa;    model: str, runs: list[dict[str, Any]], sources: list[Source], *, args: argparse.Namespace, writer: ResultWriter&#xa;) -&amp;gt; None:&#xa;    client = ModelClient(&#xa;        args.evaluation_model,&#xa;        args.api_key,&#xa;        args.base_url,&#xa;        args.timeout,&#xa;        args.app_url,&#xa;        args.app_name,&#xa;        correction_retries=args.step_retries,&#xa;        rate_limit_wait_budget_seconds=args.rate_limit_budget,&#xa;    )&#xa;    entry: dict[str, Any] = {&#xa;        &amp;quot;model&amp;quot;: model,&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="benchmark-3" name="05 Benchmark × 3 и C9 prompt — часть 3/4">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;05 Benchmark × 3 и C9 prompt — часть 3/4&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная оркестрация benchmark, политика порядка источников и template prompt stability evaluator." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part3" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 3/4&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;        &amp;quot;evaluation_model&amp;quot;: args.evaluation_model,&#xa;        &amp;quot;run_numbers&amp;quot;: [run[&amp;quot;run_number&amp;quot;] for run in runs],&#xa;        &amp;quot;status&amp;quot;: &amp;quot;failed&amp;quot;,&#xa;    }&#xa;    try:&#xa;        evaluation = await client.complete_structured(&#xa;            &amp;quot;benchmark_evaluation&amp;quot;, product_benchmark_prompt(model, runs, sources), StabilityEvaluation&#xa;        )&#xa;        entry.update({&amp;quot;status&amp;quot;: &amp;quot;completed&amp;quot;, &amp;quot;evaluation&amp;quot;: evaluation.model_dump(mode=&amp;quot;json&amp;quot;)})&#xa;    except Exception as error:&#xa;        entry[&amp;quot;error&amp;quot;] = f&amp;quot;{type(error).__name__}: {error}&amp;quot;&#xa;    entry[&amp;quot;calls&amp;quot;] = [call.__dict__ for call in client.calls]&#xa;    await writer.append_evaluation(entry)&#xa;&#xa;# eval/benchmark.py :: product_benchmark_prompt&#xa;def product_benchmark_prompt(model: str, runs: list[dict[str, Any]], sources: list[Source]) -&amp;gt; str:&#xa;    passports = {&#xa;        f&amp;quot;run_{run[&amp;#x27;run_number&amp;#x27;]}&amp;quot;: {&#xa;            &amp;quot;source_order&amp;quot;: run.get(&amp;quot;source_order&amp;quot;, []),&#xa;            &amp;quot;passport&amp;quot;: run[&amp;quot;result&amp;quot;][&amp;quot;passport&amp;quot;],&#xa;            &amp;quot;validation&amp;quot;: run[&amp;quot;result&amp;quot;][&amp;quot;validation&amp;quot;],&#xa;        }&#xa;        for run in runs&#xa;    }&#xa;    return f&amp;quot;&amp;quot;&amp;quot;You are an independent stability evaluator for product extraction.&#xa;&#xa;Evaluate C9, `Устойчивость результата`, across three completed runs of `{model}`.&#xa;Source order was intentionally varied. Compare substance, conditions, numbers,&#xa;evidence, conflicts, gaps, and product boundaries. Local IDs, wording, and&#xa;record order may differ only when their meaning is preserved.&#xa;&#xa;Return a StabilityEvaluation JSON object. Use mode=benchmark; criterion id=c9,&#xa;name=`Устойчивость результата`, and weight=5. Explain all material drift in&#xa;run_comparison. Do not claim acceptance merely because outputs look similar.&#xa;&#xa;RUNS:&#xa;{json.dumps(passports, ensure_ascii=False, indent=2)}&#xa;&#xa;SOURCE MATERIALS:&#xa;{json.dumps([source.model_dump(mode=&amp;quot;json&amp;quot;) for source in sources], ensure_ascii=False, indent=2)}&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="benchmark-4" name="05 Benchmark × 3 и C9 prompt — часть 4/4">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;05 Benchmark × 3 и C9 prompt — часть 4/4&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная оркестрация benchmark, политика порядка источников и template prompt stability evaluator." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part4" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 4/4&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;&amp;quot;&amp;quot;&amp;quot;&#xa;&#xa;# eval/benchmark.py :: sources_for_run&#xa;def sources_for_run(sources: list[Source], run_number: int) -&amp;gt; list[Source]:&#xa;    if run_number == 1:&#xa;        return list(sources)&#xa;    if run_number == 2:&#xa;        return list(reversed(sources))&#xa;    shuffled = list(sources)&#xa;    random.Random(42).shuffle(shuffled)&#xa;    return shuffled&#xa;&#xa;# Политика benchmark&#xa;&#xa;&#xa;The benchmark CLI gives each model up to three run slots. It resumes an&#xa;unfinished checkpoint, skips occupied slots, and runs the external C9&#xa;stability evaluation only after three successful passports exist:&#xa;&#xa;```sh&#xa;uv run --env-file .env python benchmark.py \&#xa;  --models-file models.txt \&#xa;  --output results/benchmark.json \&#xa;  --checkpoints checkpoints/benchmark&#xa;```&#xa;&#xa;Run 1 uses the normal source order, run 2 reverses it, and run 3 uses a&#xa;deterministic shuffle. Use `--force` to reset the selected models&amp;#x27; benchmark&#xa;slots and checkpoints.&#xa;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="runtime-1" name="06 Runtime, retries, checkpoints — часть 1/7">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;06 Runtime, retries, checkpoints — часть 1/7&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная логика runner и model client: structured JSON, correction retries, heartbeat, metrics, persistence и выбор паспорта." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part1" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 1/7&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;# eval/tempo_eval/client.py :: correction_prompt&#xa;def correction_prompt(original: str, raw_response: str | None, error: Exception) -&amp;gt; str:&#xa;    return f&amp;quot;&amp;quot;&amp;quot;The previous response did not satisfy the requested output.&#xa;&#xa;Original request:&#xa;{original[:30000]}&#xa;&#xa;Previous response:&#xa;{(raw_response or &amp;quot;[no response returned]&amp;quot;)[:16000]}&#xa;&#xa;Validation or parsing error:&#xa;{_error_text(error)}&#xa;&#xa;Correct the previous response. Return the complete response again as one valid JSON object only.&#xa;Do not explain the correction and do not use Markdown fences.&amp;quot;&amp;quot;&amp;quot;&#xa;&#xa;# eval/tempo_eval/client.py :: strict_schema&#xa;def strict_schema(schema: dict[str, Any]) -&amp;gt; dict[str, Any]:&#xa;    result = copy.deepcopy(schema)&#xa;    values: list[Any] = [result]&#xa;    while values:&#xa;        value = values.pop()&#xa;        if isinstance(value, dict):&#xa;            if &amp;quot;properties&amp;quot; in value:&#xa;                value[&amp;quot;required&amp;quot;] = list(value[&amp;quot;properties&amp;quot;])&#xa;                value[&amp;quot;additionalProperties&amp;quot;] = False&#xa;            values.extend(value.values())&#xa;        elif isinstance(value, list):&#xa;            values.extend(value)&#xa;    return result&#xa;&#xa;# eval/tempo_eval/runner.py :: run_models&#xa;async def run_models(&#xa;    models: list[str],&#xa;    sources: list[Source],&#xa;    *,&#xa;    target_product: str,&#xa;    as_of_date: str | None,&#xa;    api_key: str,&#xa;    base_url: str,&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="runtime-2" name="06 Runtime, retries, checkpoints — часть 2/7">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;06 Runtime, retries, checkpoints — часть 2/7&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная логика runner и model client: structured JSON, correction retries, heartbeat, metrics, persistence и выбор паспорта." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part2" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 2/7&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;    checkpoint_dir: Path,&#xa;    output_path: Path,&#xa;    timeout_seconds: float,&#xa;    step_retries: int,&#xa;    app_url: str | None,&#xa;    app_name: str | None,&#xa;    run_id: str,&#xa;    pipeline: str = &amp;quot;product&amp;quot;,&#xa;    audience_dataset: Path | None = None,&#xa;    audience_db: Path | None = None,&#xa;    product_passport: dict[str, Any] | None = None,&#xa;    semantic_index_dir: Path | None = None,&#xa;    rate_limit_wait_budget_seconds: float = 45.0,&#xa;    run_timeout_seconds: float = 180.0,&#xa;) -&amp;gt; None:&#xa;    writer = ResultWriter(&#xa;        output_path,&#xa;        {&#xa;            &amp;quot;run_id&amp;quot;: run_id,&#xa;            &amp;quot;created_at&amp;quot;: datetime.now(UTC).isoformat(),&#xa;            &amp;quot;target_product&amp;quot;: target_product,&#xa;            &amp;quot;as_of_date&amp;quot;: as_of_date,&#xa;            &amp;quot;source_names&amp;quot;: [source.source for source in sources],&#xa;            &amp;quot;pipeline&amp;quot;: pipeline,&#xa;        },&#xa;    )&#xa;    checkpoint_dir.mkdir(parents=True, exist_ok=True)&#xa;    await asyncio.gather(&#xa;        *(&#xa;            run_one_model(&#xa;                model,&#xa;                sources,&#xa;                target_product=target_product,&#xa;                as_of_date=as_of_date,&#xa;                api_key=api_key,&#xa;                base_url=base_url,&#xa;                checkpoint_dir=checkpoint_dir,&#xa;                timeout_seconds=timeout_seconds,&#xa;                step_retries=step_retries,&#xa;                app_url=app_url,&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="runtime-3" name="06 Runtime, retries, checkpoints — часть 3/7">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;06 Runtime, retries, checkpoints — часть 3/7&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная логика runner и model client: structured JSON, correction retries, heartbeat, metrics, persistence и выбор паспорта." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part3" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 3/7&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;                app_name=app_name,&#xa;                run_id=run_id,&#xa;                writer=writer,&#xa;                pipeline=pipeline,&#xa;                audience_dataset=audience_dataset,&#xa;                audience_db=audience_db,&#xa;                product_passport=product_passport,&#xa;                semantic_index_dir=semantic_index_dir,&#xa;                rate_limit_wait_budget_seconds=rate_limit_wait_budget_seconds,&#xa;                run_timeout_seconds=run_timeout_seconds,&#xa;            )&#xa;            for model in models&#xa;        )&#xa;    )&#xa;&#xa;# eval/tempo_eval/runner.py :: run_one_model&#xa;async def run_one_model(&#xa;    model: str,&#xa;    sources: list[Source],&#xa;    *,&#xa;    target_product: str,&#xa;    as_of_date: str | None,&#xa;    api_key: str,&#xa;    base_url: str,&#xa;    checkpoint_dir: Path,&#xa;    timeout_seconds: float,&#xa;    step_retries: int,&#xa;    app_url: str | None,&#xa;    app_name: str | None,&#xa;    run_id: str,&#xa;    writer: ResultWriter,&#xa;    run_number: int | None = None,&#xa;    checkpoint_path: Path | None = None,&#xa;    resume: bool = False,&#xa;    source_order: list[str] | None = None,&#xa;    input_order: dict[str, list[str]] | None = None,&#xa;    pipeline: str = &amp;quot;product&amp;quot;,&#xa;    audience_dataset: Path | None = None,&#xa;    audience_db: Path | None = None,&#xa;    product_passport: dict[str, Any] | None = None,&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="runtime-4" name="06 Runtime, retries, checkpoints — часть 4/7">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;06 Runtime, retries, checkpoints — часть 4/7&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная логика runner и model client: structured JSON, correction retries, heartbeat, metrics, persistence и выбор паспорта." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part4" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 4/7&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;    semantic_index_dir: Path | None = None,&#xa;    rate_limit_wait_budget_seconds: float = 45.0,&#xa;    run_timeout_seconds: float | None = None,&#xa;) -&amp;gt; None:&#xa;    started = datetime.now(UTC)&#xa;    LOGGER.info(&amp;quot;run_start pipeline=%s model=%s run_number=%s&amp;quot;, pipeline, model, run_number or &amp;quot;single&amp;quot;)&#xa;    client: ModelClient | None = None&#xa;    checkpoint_path = checkpoint_path or checkpoint_dir / f&amp;quot;{slugify(model)}.sqlite&amp;quot;&#xa;    record: dict[str, Any] = {&#xa;        &amp;quot;model&amp;quot;: model,&#xa;        &amp;quot;checkpoint&amp;quot;: str(checkpoint_path),&#xa;        &amp;quot;status&amp;quot;: &amp;quot;failed&amp;quot;,&#xa;        **({&amp;quot;run_number&amp;quot;: run_number} if run_number is not None else {}),&#xa;        **({&amp;quot;source_order&amp;quot;: source_order} if source_order is not None else {}),&#xa;        **({&amp;quot;input_order&amp;quot;: input_order} if input_order is not None else {}),&#xa;    }&#xa;    try:&#xa;        client = ModelClient(&#xa;            model,&#xa;            api_key,&#xa;            base_url,&#xa;            timeout_seconds,&#xa;            app_url,&#xa;            app_name,&#xa;            correction_retries=step_retries,&#xa;            rate_limit_wait_budget_seconds=rate_limit_wait_budget_seconds,&#xa;        )&#xa;        async with AsyncSqliteSaver.from_conn_string(str(checkpoint_path)) as checkpointer:&#xa;            await checkpointer.setup()&#xa;            if pipeline == &amp;quot;audience&amp;quot;:&#xa;                if audience_dataset is None or product_passport is None:&#xa;                    raise ValueError(&amp;quot;audience pipeline requires an XLSX dataset and a product passport&amp;quot;)&#xa;                workflow = AudienceWorkflow(&#xa;                    client,&#xa;                    audience_dataset,&#xa;                    db_path=audience_db,&#xa;                    semantic_index_dir=semantic_index_dir or checkpoint_dir / &amp;quot;semantic-index&amp;quot;,&#xa;                )&#xa;            else:&#xa;                workflow = Workflow(client, step_retries=step_retries)&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="runtime-5" name="06 Runtime, retries, checkpoints — часть 5/7">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;06 Runtime, retries, checkpoints — часть 5/7&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная логика runner и model client: structured JSON, correction retries, heartbeat, metrics, persistence и выбор паспорта." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part5" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 5/7&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;            graph = workflow.compile(checkpointer)&#xa;            thread_id = read_thread_id(checkpoint_path) if resume else None&#xa;            graph_input = (&#xa;                None&#xa;                if resume&#xa;                else _initial_state(&#xa;                    pipeline,&#xa;                    model=model,&#xa;                    target_product=target_product,&#xa;                    as_of_date=as_of_date,&#xa;                    sources=sources,&#xa;                    audience_dataset=audience_dataset,&#xa;                    product_passport=product_passport,&#xa;                    audience_data_profile=workflow.dataset.profile() if pipeline == &amp;quot;audience&amp;quot; else None,&#xa;                )&#xa;            )&#xa;            graph_config = {&amp;quot;configurable&amp;quot;: {&amp;quot;thread_id&amp;quot;: thread_id or f&amp;quot;{run_id}:{slugify(model)}&amp;quot;}}&#xa;            if run_timeout_seconds is None:&#xa;                final_state = await graph.ainvoke(graph_input, graph_config)&#xa;            else:&#xa;                async with asyncio.timeout(run_timeout_seconds):&#xa;                    final_state = await graph.ainvoke(graph_input, graph_config)&#xa;        record.update({&amp;quot;status&amp;quot;: &amp;quot;completed&amp;quot;, &amp;quot;result&amp;quot;: _result_from_state(final_state, pipeline)})&#xa;    except Exception as error:&#xa;        record[&amp;quot;error&amp;quot;] = f&amp;quot;{type(error).__name__}: {error}&amp;quot;&#xa;        LOGGER.exception(&amp;quot;run_error pipeline=%s model=%s error=%s&amp;quot;, pipeline, model, record[&amp;quot;error&amp;quot;])&#xa;    record[&amp;quot;duration_seconds&amp;quot;] = (datetime.now(UTC) - started).total_seconds()&#xa;    calls = [asdict(call) for call in client.calls] if client else []&#xa;    record[&amp;quot;calls&amp;quot;] = calls&#xa;    record[&amp;quot;call_count&amp;quot;] = len(calls)&#xa;    record[&amp;quot;input_tokens&amp;quot;] = sum(call[&amp;quot;input_tokens&amp;quot;] or 0 for call in calls)&#xa;    record[&amp;quot;output_tokens&amp;quot;] = sum(call[&amp;quot;output_tokens&amp;quot;] or 0 for call in calls)&#xa;    LOGGER.info(&#xa;        &amp;quot;run_end pipeline=%s model=%s status=%s duration=%.1fs calls=%d input_tokens=%d output_tokens=%d&amp;quot;,&#xa;        pipeline,&#xa;        model,&#xa;        record[&amp;quot;status&amp;quot;],&#xa;        record[&amp;quot;duration_seconds&amp;quot;],&#xa;        record[&amp;quot;call_count&amp;quot;],&#xa;        record[&amp;quot;input_tokens&amp;quot;],&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="runtime-6" name="06 Runtime, retries, checkpoints — часть 6/7">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;06 Runtime, retries, checkpoints — часть 6/7&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная логика runner и model client: structured JSON, correction retries, heartbeat, metrics, persistence и выбор паспорта." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part6" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 6/7&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;        record[&amp;quot;output_tokens&amp;quot;],&#xa;    )&#xa;    await writer.append(record)&#xa;&#xa;# eval/tempo_eval/runner.py :: load_product_passport&#xa;def load_product_passport(path: Path, model: str | None = None) -&amp;gt; dict[str, Any]:&#xa;    try:&#xa;        payload = json.loads(path.read_text(encoding=&amp;quot;utf-8&amp;quot;))&#xa;    except (OSError, json.JSONDecodeError) as error:&#xa;        raise ValueError(f&amp;quot;cannot read product result {path}: {error}&amp;quot;) from error&#xa;    candidates = payload.get(&amp;quot;results&amp;quot;, []) if isinstance(payload, dict) else []&#xa;    if isinstance(payload, dict) and payload.get(&amp;quot;result&amp;quot;, {}).get(&amp;quot;passport&amp;quot;):&#xa;        candidates = [payload]&#xa;    eligible = [&#xa;        item&#xa;        for item in candidates&#xa;        if isinstance(item, dict)&#xa;        and (not model or item.get(&amp;quot;model&amp;quot;) == model)&#xa;        and item.get(&amp;quot;status&amp;quot;) in (None, &amp;quot;completed&amp;quot;)&#xa;        and item.get(&amp;quot;result&amp;quot;, {}).get(&amp;quot;passport&amp;quot;)&#xa;    ]&#xa;    eligible.sort(key=_product_result_sort_key)&#xa;    if eligible:&#xa;        selected = eligible[0]&#xa;        LOGGER.info(&#xa;            &amp;quot;product_passport_selected path=%s model=%s run_number=%s&amp;quot;,&#xa;            path,&#xa;            selected.get(&amp;quot;model&amp;quot;, model or &amp;quot;unknown&amp;quot;),&#xa;            selected.get(&amp;quot;run_number&amp;quot;, &amp;quot;single&amp;quot;),&#xa;        )&#xa;        return selected[&amp;quot;result&amp;quot;][&amp;quot;passport&amp;quot;]&#xa;    raise ValueError(f&amp;quot;no completed product passport found in {path}&amp;quot;)&#xa;&#xa;# eval/tempo_eval/runner.py :: compact_product_passport&#xa;def compact_product_passport(passport: dict[str, Any]) -&amp;gt; dict[str, Any]:&#xa;    categories = {&#xa;        &amp;quot;identity&amp;quot;,&#xa;        &amp;quot;purpose&amp;quot;,&#xa;        &amp;quot;jtbd&amp;quot;,&#xa;        &amp;quot;audience&amp;quot;,&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="runtime-7" name="06 Runtime, retries, checkpoints — часть 7/7">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;06 Runtime, retries, checkpoints — часть 7/7&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Точная логика runner и model client: structured JSON, correction retries, heartbeat, metrics, persistence и выбор паспорта." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part7" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 7/7&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;        &amp;quot;features&amp;quot;,&#xa;        &amp;quot;benefits&amp;quot;,&#xa;        &amp;quot;pricing&amp;quot;,&#xa;        &amp;quot;limitations&amp;quot;,&#xa;        &amp;quot;offers_channels&amp;quot;,&#xa;    }&#xa;    fields = (&amp;quot;id&amp;quot;, &amp;quot;category&amp;quot;, &amp;quot;subject&amp;quot;, &amp;quot;statement&amp;quot;, &amp;quot;conditions&amp;quot;, &amp;quot;time_scope&amp;quot;, &amp;quot;evidence_status&amp;quot;)&#xa;    records = [&#xa;        {field: record.get(field) for field in fields}&#xa;        for record in passport.get(&amp;quot;records&amp;quot;, [])&#xa;        if record.get(&amp;quot;category&amp;quot;) in categories&#xa;    ]&#xa;    product_jtbd = [record for record in records if record.get(&amp;quot;category&amp;quot;) == &amp;quot;jtbd&amp;quot;]&#xa;    return {&#xa;        &amp;quot;product_name&amp;quot;: passport.get(&amp;quot;product_name&amp;quot;),&#xa;        &amp;quot;extraction_status&amp;quot;: passport.get(&amp;quot;extraction_status&amp;quot;),&#xa;        &amp;quot;records&amp;quot;: records,&#xa;        &amp;quot;product_jtbd&amp;quot;: product_jtbd,&#xa;        &amp;quot;product_jtbd_status&amp;quot;: &amp;quot;extracted&amp;quot; if product_jtbd else &amp;quot;not_extracted&amp;quot;,&#xa;        &amp;quot;warnings&amp;quot;: passport.get(&amp;quot;warnings&amp;quot;, []),&#xa;    }&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="orchestration-1" name="07 Оркестрация и передача результата — часть 1/3">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;07 Оркестрация и передача результата — часть 1/3&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Product-фаза one-model pipeline и детерминированная передача product passport в audience." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part1" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 1/3&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;# eval/one_model_pipeline.py :: run_pipeline&#xa;async def run_pipeline(args: argparse.Namespace) -&amp;gt; None:&#xa;    if not args.api_key:&#xa;        raise SystemExit(&amp;quot;OPENROUTER_API_KEY or --api-key is required&amp;quot;)&#xa;    if args.step_retries &amp;lt; 1:&#xa;        raise SystemExit(&amp;quot;--step-retries must be at least 1&amp;quot;)&#xa;    if args.run_timeout &amp;lt; 0:&#xa;        raise SystemExit(&amp;quot;--run-timeout must be non-negative&amp;quot;)&#xa;    if args.rate_limit_budget &amp;lt; 0:&#xa;        raise SystemExit(&amp;quot;--rate-limit-budget must be non-negative&amp;quot;)&#xa;&#xa;    output_dir = args.output_dir&#xa;    checkpoints_dir = args.checkpoints_dir&#xa;    reports_dir = args.reports_dir&#xa;    output_dir.mkdir(parents=True, exist_ok=True)&#xa;    checkpoints_dir.mkdir(parents=True, exist_ok=True)&#xa;    reports_dir.mkdir(parents=True, exist_ok=True)&#xa;&#xa;    product_result = output_dir / &amp;quot;product-one.json&amp;quot;&#xa;    product_checkpoints = checkpoints_dir / &amp;quot;product&amp;quot;&#xa;    audience_single_result = output_dir / &amp;quot;audience-one.json&amp;quot;&#xa;    audience_single_checkpoints = checkpoints_dir / &amp;quot;audience-one&amp;quot;&#xa;    audience_three_result = output_dir / &amp;quot;audience-three.json&amp;quot;&#xa;    audience_three_checkpoints = checkpoints_dir / &amp;quot;audience-three&amp;quot;&#xa;&#xa;    # Phase 1: the product passport is the only input passed to the audience graph.&#xa;    await run_models(&#xa;        [args.model],&#xa;        load_sources(args.input_dir),&#xa;        target_product=args.target_product,&#xa;        as_of_date=args.as_of_date,&#xa;        api_key=args.api_key,&#xa;        base_url=args.base_url,&#xa;        checkpoint_dir=product_checkpoints,&#xa;        output_path=product_result,&#xa;        timeout_seconds=args.timeout,&#xa;        step_retries=args.step_retries,&#xa;        app_url=args.app_url,&#xa;        app_name=args.app_name,&#xa;        run_id=&amp;quot;product-one&amp;quot;,&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="orchestration-2" name="07 Оркестрация и передача результата — часть 2/3">
    <mxGraphModel dx="1600" dy="900" grid="1" page="1" pageScale="1" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;07 Оркестрация и передача результата — часть 2/3&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Product-фаза one-model pipeline и детерминированная передача product passport в audience." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part2" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 2/3&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;        pipeline=&amp;quot;product&amp;quot;,&#xa;        rate_limit_wait_budget_seconds=args.rate_limit_budget,&#xa;        run_timeout_seconds=args.run_timeout or None,&#xa;    )&#xa;    product_passport = compact_product_passport(load_product_passport(product_result, args.model))&#xa;&#xa;    # Phase 2: one dependent audience run and its immediate report.&#xa;    await run_models(&#xa;        [args.model],&#xa;        [],&#xa;        target_product=args.target_product,&#xa;        as_of_date=args.as_of_date,&#xa;        api_key=args.api_key,&#xa;        base_url=args.base_url,&#xa;        checkpoint_dir=audience_single_checkpoints,&#xa;        output_path=audience_single_result,&#xa;        timeout_seconds=args.timeout,&#xa;        step_retries=args.step_retries,&#xa;        app_url=args.app_url,&#xa;        app_name=args.app_name,&#xa;        run_id=&amp;quot;audience-one&amp;quot;,&#xa;        pipeline=&amp;quot;audience&amp;quot;,&#xa;        audience_dataset=args.audience_data,&#xa;        audience_db=args.audience_db,&#xa;        product_passport=product_passport,&#xa;        semantic_index_dir=args.semantic_index,&#xa;        rate_limit_wait_budget_seconds=args.rate_limit_budget,&#xa;        run_timeout_seconds=args.run_timeout or None,&#xa;    )&#xa;    single_report = ReportBuilder(output_dir, checkpoints_dir, pipeline=&amp;quot;auto&amp;quot;)&#xa;    single_report.max_runs = 1&#xa;    single_report.write(reports_dir / &amp;quot;single-run.html&amp;quot;)&#xa;&#xa;    # Phase 3: three fresh audience runs plus the existing deterministic stability check.&#xa;    await run_benchmark(_benchmark_args(args, product_result, audience_three_result, audience_three_checkpoints))&#xa;    ReportBuilder(output_dir, checkpoints_dir, pipeline=&amp;quot;auto&amp;quot;).write(reports_dir / &amp;quot;three-run-consistency.html&amp;quot;)&#xa;&#xa;    print(f&amp;quot;Product result: {product_result}&amp;quot;)&#xa;    print(f&amp;quot;Single audience report: {reports_dir / &amp;#x27;single-run.html&amp;#x27;}&amp;quot;)&#xa;    print(f&amp;quot;Three-run audience result: {audience_three_result}&amp;quot;)&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="orchestration-3" name="07 Оркестрация и передача результата — часть 3/3">
