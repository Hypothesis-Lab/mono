        <mxCell id="part4" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 4/4&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;&#xa;{{PASSPORT_JSON}}&#xa;&#xa;### Результат структурной проверки&#xa;&#xa;{{VALIDATION_JSON}}&#xa;&#xa;### Исходные материалы&#xa;&#xa;{{SOURCE_MATERIALS_JSON}}&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
