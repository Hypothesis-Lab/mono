        <mxCell id="title" value="&lt;b&gt;07 Оркестрация и передача результата — часть 3/3&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Product-фаза one-model pipeline и детерминированная передача product passport в audience." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="part3" value="&lt;div style=&#39;font-size:16px&#39;&gt;&lt;b&gt;Часть 3/3&lt;/b&gt;&lt;/div&gt;&lt;pre style=&#39;font-size:14px;white-space:pre-wrap;margin-top:8px&#39;&gt;    print(f&amp;quot;Three-run consistency report: {reports_dir / &amp;#x27;three-run-consistency.html&amp;#x27;}&amp;quot;)&#xa;&#xa;# Контракт product → audience&#xa;Product run завершается первым. load_product_passport() выбирает минимальный завершённый run_number. compact_product_passport() передаёт product_name, extraction_status, records, product_jtbd, product_jtbd_status и warnings в audience workflow.&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="1500" height="760" as="geometry" />
